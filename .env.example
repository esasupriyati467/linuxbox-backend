# Wajib: JWT secret dari Supabase project (Settings -> API -> JWT Secret).
SUPABASE_JWT_SECRET=replace-me

# Origin frontend yang diizinkan (comma-separated). Pakai * untuk dev.
ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://your-app.lovable.app

# Opsional
PORT=8080
WORKSPACES_ROOT=/workspaces
SANDBOX_SHELL=/bin/bash
IDLE_TIMEOUT_MS=1800000